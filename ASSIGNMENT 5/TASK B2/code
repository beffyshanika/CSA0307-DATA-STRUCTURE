#include <stdio.h>
#include <limits.h>

#define V 6
#define INF LLONG_MAX

long long w[V][V] = {
    {0,7,9,0,0,14},
    {7,0,10,15,0,0},
    {9,10,0,11,0,2},
    {0,15,11,0,6,0},
    {0,0,0,6,0,9},
    {14,0,2,0,9,0}
};

void dijkstra(void)
{
    long long dist[V];
    int prev[V], done[V] = {0};

    for (int i = 0; i < V; i++) {
        dist[i] = INF;
        prev[i] = -1;
    }

    dist[0] = 0;

    for (int round = 0; round < V; round++) {
        int u = -1;

        for (int v = 0; v < V; v++)
            if (!done[v] && dist[v] != INF &&
                (u == -1 || dist[v] < dist[u]))
                u = v;

        if (u == -1)
            break;

        done[u] = 1;

        for (int v = 0; v < V; v++) {
            if (w[u][v] > 0 && !done[v] &&
                dist[u] <= LLONG_MAX - w[u][v] &&
                dist[u] + w[u][v] < dist[v]) {

                dist[v] = dist[u] + w[u][v];
                prev[v] = u;
            }
        }
    }

    printf("Dijkstra distances:\n");

    for (int v = 0; v < V; v++) {
        if (dist[v] == INF)
            printf("INF ");
        else
            printf("%lld ", dist[v]);
    }

    printf("\nRoute to 4:");

    if (dist[4] == INF) {
        printf(" Unreachable");
    } else {
        int route[V], count = 0;

        for (int v = 4; v != -1; v = prev[v])
            route[count++] = v;

        for (int i = count - 1; i >= 0; i--)
            printf(" %d", route[i]);
    }

    printf("\n");
}

void negative_edge_test(void)
{
    int d[3][3] = {
        {0, 2, 5},
        {999, 0, -4},
        {999, 999, 0}
    };

    for (int k = 0; k < 3; k++)
        for (int i = 0; i < 3; i++)
            for (int j = 0; j < 3; j++)
                if (d[i][k] != 999 && d[k][j] != 999 &&
                    d[i][k] + d[k][j] < d[i][j])
                    d[i][j] = d[i][k] + d[k][j];

    printf("Floyd-Warshall distance 0 to 2 with negative edge: %d\n",
           d[0][2]);
}

void cycle_test(void)
{
    int g[3][3] = {
        {0,1,0},
        {0,0,1},
        {1,0,0}
    };

    int indeg[3] = {0};
    int queue[3], front = 0, rear = 0;
    int done = 0;

    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            indeg[j] += g[i][j];

    for (int i = 0; i < 3; i++)
        if (indeg[i] == 0)
            queue[rear++] = i;

    while (front < rear) {
        int u = queue[front++];
        done++;

        for (int v = 0; v < 3; v++) {
            if (g[u][v]) {
                indeg[v]--;

                if (indeg[v] == 0)
                    queue[rear++] = v;
            }
        }
    }

    printf("Topological test: %s\n",
           done == 3 ? "No cycle" : "Cycle detected");
}

int main(void)
{
    dijkstra();
    negative_edge_test();
    cycle_test();

    return 0;
}
