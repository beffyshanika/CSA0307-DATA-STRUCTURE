#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define LEN 100
#define ALPHABET 26

// Trie node structure
typedef struct Trie {
    struct Trie *ch[ALPHABET];
    int end;
} Trie;

// Create a new Trie node
Trie *newnode(void) {
    Trie *t = (Trie *)malloc(sizeof(Trie));

    if (t == NULL) {
        printf("Memory allocation failed\n");
        exit(1);
    }

    for (int i = 0; i < ALPHABET; i++) {
        t->ch[i] = NULL;
    }

    t->end = 0;
    return t;
}

// Insert a word into the Trie
void insert(Trie *t, const char *word) {
    for (int i = 0; word[i] != '\0'; i++) {
        int k = word[i] - 'a';

        if (k < 0 || k >= ALPHABET) {
            return;
        }

        if (t->ch[k] == NULL) {
            t->ch[k] = newnode();
        }

        t = t->ch[k];
    }

    t->end = 1;
}

