#include <stdio.h>

int main(void) {
    int a[] = {22, 14, 9, 3, 7, 16};
    int key = 3;
    int n = sizeof(a) / sizeof(a[0]);
    int i, count = 0;
    int found = 0;

    for (i = 0; i < n; i++) {
        count++;
        printf("Comparing %d with %d\\n", a[i], key);

        if (a[i] == key) {
            found = 1;
            printf("Element found!\\n");
            printf("Position: %d\\n", i + 1);
            printf("Index: %d\\n", i);
            break;
        }
    }

    if (found) {
        printf("Total Comparisons: %d\\n", count);
    } else {
        printf("Element not found!\\n");
        printf("Total Comparisons: %d\\n", count);
    }

    return 0;
}
